{
  // Wunderkind OMO configuration template (canonical filename)
  // ──────────────────────────────────────────────────────────────────────
  // Upstream now prefers "oh-my-openagent" for plugin entries, package naming,
  // and OMO config basenames.
  // Use this file as your project's .opencode/oh-my-openagent.jsonc to
  // activate the full wunderkind agent suite with recommended settings.
  //
  // All agent names are namespaced as "wunderkind:<agent-name>" by the plugin loader.
  //
  // Schema baseline metadata tracks oh-my-openagent 5.0.0-beta.86, while the published
  // template continues to use the canonical upstream schema URL expected by the
  // current source/test contract.
  //
  // Cost-tier policy: GPT-6 Sol is the standard/high-capability default and GPT-6
  // Luna is the low-cost routine/background tier. This template never assigns
  // Astra; operators who need it must configure it in their own OMO override.
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",

  "categories": {
    "quick": { "model": "openai/gpt-6-luna", "variant": "low" },
    "unspecified-low": { "model": "openai/gpt-6-luna", "variant": "low" },
    "unspecified-high": { "model": "openai/gpt-6-sol", "variant": "high" },
    "writing": { "model": "openai/gpt-6-luna", "variant": "medium" },
    "visual-engineering": { "model": "openai/gpt-6-sol", "variant": "medium" },
    "deep-low": { "model": "openai/gpt-6-sol", "variant": "high" },
    "deep-high": { "model": "openai/gpt-6-sol", "variant": "high" },
    "ultrabrain": { "model": "openai/gpt-6-sol", "variant": "high" },
    "git": { "model": "openai/gpt-6-luna", "variant": "low" }
  },

  "agents": {
    // Reviewed upstream built-in routing; applying this template is operator-controlled.
    "build": { "model": "openai/gpt-6-sol", "variant": "medium" },
    "OpenCode-Builder": { "model": "openai/gpt-6-sol", "variant": "medium" },
    "sisyphus": { "model": "openai/gpt-6-sol", "variant": "medium" },
    "atlas": { "model": "openai/gpt-6-sol", "variant": "medium" },
    "hephaestus": { "model": "openai/gpt-6-sol", "variant": "high" },
    "sisyphus-junior": { "model": "openai/gpt-6-sol", "variant": "high" },
    "plan": { "model": "openai/gpt-6-sol", "variant": "high" },
    "prometheus": { "model": "openai/gpt-6-sol", "variant": "high" },
    "metis": { "model": "openai/gpt-6-sol", "variant": "high" },
    "momus": { "model": "openai/gpt-6-sol", "variant": "high" },
    "oracle": { "model": "openai/gpt-6-sol", "variant": "high" },
    "multimodal-looker": { "model": "openai/gpt-6-sol", "variant": "medium" },
    "explore": { "model": "openai/gpt-6-luna", "variant": "medium" },
    "librarian": { "model": "openai/gpt-6-luna", "variant": "medium" },
    // ── Marketing ──────────────────────────────────────────────────────────────
    // CMO-calibre: go-to-market, brand, community, developer advocacy, docs-led launches, analytics
    "wunderkind:marketing-wunderkind": {
      "mode": "primary",
      "category": "writing",
      "color": "#FF6B35",
      "description": "CMO-calibre marketing strategist. Brand, GTM, community, PR, developer advocacy, docs-led launches, tutorials, migration support, funnel analytics, and DX adoption work."
    },

    // ── Design ─────────────────────────────────────────────────────────────────
    // Creative Director: brand identity, design systems, UI/UX, accessibility
    "wunderkind:creative-director": {
      "mode": "primary",
      "category": "visual-engineering",
      "color": "#A855F7",
      "description": "Brand identity, design systems, UI/UX, typography, colour, accessibility, design tokens."
    },

    // ── Product ─────────────────────────────────────────────────────────────────
    // VP Product-calibre: roadmaps, OKRs, PRDs, sprint planning, task decomposition
    "wunderkind:product-wunderkind": {
      "mode": "primary",
      "category": "unspecified-high",
      "color": "#3B82F6",
      "description": "Default orchestrator and front door for all Wunderkind requests. Routes mixed-domain and ambiguous work. VP Product authority: roadmaps, OKRs, PRDs, issue intake, acceptance review, sprint planning, and decomposition."
    },

    // ── Engineering ─────────────────────────────────────────────────────────────
    // CTO-calibre: full-stack, DB, Vercel/Next.js, architecture, code review, AI
    "wunderkind:fullstack-wunderkind": {
      "mode": "primary",
      "category": "unspecified-high",
      "color": "#10B981",
      "description": "CTO-calibre full-stack engineer. Frontend, backend, DB, Vercel, architecture, AI integration."
    },

    // ── Security ────────────────────────────────────────────────────────────────
    // CISO: security architecture, OWASP, threat modelling, compliance, pen testing
    "wunderkind:ciso": {
      "mode": "primary",
      "category": "unspecified-high",
      "color": "#EF4444",
      "description": "CISO: security architecture, OWASP, threat modelling, GDPR/CCPA/POPIA, pen testing, breach response."
    },

    // ── Legal ────────────────────────────────────────────────────────────────────
    // OSS licensing, TOS, privacy policy, DPAs, CLAs, contract review, GDPR/CCPA obligations
    "wunderkind:legal-counsel": {
      "mode": "primary",
      "category": "unspecified-high",
      "color": "#6366F1",
      "description": "OSS licensing, TOS, privacy policy, DPAs, CLAs, contract review, GDPR/CCPA compliance obligations."
    }
  }
}
