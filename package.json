{
  "name": "@grant-vine/wunderkind",
  "version": "0.27.8",
  "description": "Wunderkind — specialist AI agent addon for OpenCode with 6 retained specialist agents for any software product team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wunderkind": "bin/wunderkind.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "agents/",
    "commands/",
    "schemas/",
    "skills/",
    "codex/",
    ".claude-plugin/",
    "bin/",
    "oh-my-openagent.jsonc",
    "wunderkind.config.jsonc"
  ],
  "scripts": {
    "build": "tsc && bun run dist/build-agents.js && bun run dist/build-codex.js",
    "dev": "tsc --watch",
    "prepublishOnly": "bun run build",
    "test": "bun test tests/unit/",
    "test:contract": "bun test tests/unit/",
    "test:coverage": "bun test --coverage tests/unit/",
    "test:coverage:config-manager": "bun test --coverage tests/unit/config-manager-coverage.test.ts",
    "test:prompt-efficacy": "bun tests/unit/helpers/run-prompt-optimization-efficacy.mjs --repeat 5 --enforce-repeatable",
    "test:prompt-benchmark": "bun tests/unit/helpers/run-prompt-optimization-benchmark-pack.mjs",
    "test:prompt-answer-quality": "bun tests/unit/helpers/run-prompt-answer-quality-eval.mjs",
    "eval:prompt-answer-quality:live": "bun tests/unit/helpers/run-prompt-answer-quality-eval.mjs --provider command"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@opencode-ai/plugin": "1.18.31",
    "@opencode-ai/sdk": "1.18.31",
    "commander": "^15.0.0",
    "js-tiktoken": "1.0.21",
    "jsonc-parser": "^3.3.1",
    "oh-my-openagent": "5.0.0-beta.62",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "oh-my-openagent",
    "oh-my-opencode",
    "opencode",
    "plugin",
    "wunderkind",
    "agents",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grant-vine/wunderkind.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "picomatch": "4.0.7",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "path-to-regexp": "8.4.2",
    "fast-uri": "4.1.5",
    "ip-address": "10.7.1",
    "uuid": "14.0.2"
  }
}
